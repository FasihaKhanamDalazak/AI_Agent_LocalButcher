# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development
DEBUG=true

# --- Supabase: use the "Session pooler" connection string ---
# (Project Settings -> Database -> Connection string -> Session pooler)
# Take that one string and build BOTH lines below from it:

# Async (asyncpg) — used by the running FastAPI app. No sslmode query param
# here; SSL is set in code via connect_args (see app/db/session.py).
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Sync (psycopg2) — used only by Alembic migrations. sslmode is a normal
# query param for psycopg2, so it's appended directly here.
DATABASE_URL_SYNC=postgresql+psycopg2://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Alias that Google repoints to their current recommended Flash model —
# don't pin an exact version here unless you deliberately want to freeze it.
GEMINI_MODEL=gemini-flash-latest

# Real-time speech-to-text for the voice endpoint. Free tier available at
# https://console.deepgram.com/signup
DEEPGRAM_API_KEY=your-deepgram-api-key

# --- Phone-call agent (app/api/v1/endpoints/calls.py, app/services/telephony_service.py) ---
# Exotel has no HMAC request signing (unlike Twilio) — Basic Auth on the
# WebSocket handshake is its documented alternative. Set the SAME username/
# password here and in Exotel's Voicebot Applet config for your number.
EXOTEL_BASIC_AUTH_USERNAME=replace-with-a-shared-username
EXOTEL_BASIC_AUTH_PASSWORD=replace-with-a-long-random-string
# Set to false ONLY if your Exotel Voicebot Applet has no Basic Auth field
# available yet (seen in practice before Exotel enables the Stream/Voicebot
# Applet feature on an account) — every connection accepted this way is
# logged loudly as a warning. Flip back to true (or omit — true is the
# default) once Basic Auth is available on the Exotel side.
EXOTEL_REQUIRE_AUTH=true
# Deepgram's managed Google provider needs a model from ITS OWN supported
# list — "gemini-flash-latest" (the alias used above) is rejected. Reuses
# DEEPGRAM_API_KEY above; no separate Gemini key needed for this path.
VOICE_AGENT_GEMINI_MODEL=gemini-2.5-flash
# One of Deepgram's Aura English voices — see
# https://developers.deepgram.com/docs/tts-models for the full list.
VOICE_AGENT_TTS_VOICE=aura-2-helena-en
# MUST match what Exotel actually sends (confirmed via a real call's
# logged `start` event media_format, not assumed from docs) — mismatched
# rates cause pitch/speed-distorted audio. This account's Voicebot Applet
# has no sample-rate selector and uses 8000. Verify against a live call's
# logs before changing this if your account/plan differs.
CALL_AUDIO_SAMPLE_RATE=8000
