# Base URL of the Local Butcher backend (no trailing slash)
# Local dev:   http://localhost:8000
# Deployed:    https://<your-app>.koyeb.app  (or wherever the backend ends up)
VITE_API_URL=http://localhost:8000

# WebSocket base for the real-time voice endpoint (no trailing slash)
# Local dev:   ws://localhost:8000
# Deployed:    wss://<your-app>.koyeb.app  (wss, not ws, once served over https)
VITE_WS_URL=ws://localhost:8000
